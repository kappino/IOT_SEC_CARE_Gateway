# ==============================================================================
# IOT_SEC_CARE_Gateway - Environment Configuration Template
# Copy this file to .env and adapt parameters for your deployment.
# ==============================================================================

# MQTT Broker (mTLS v1.3)
MQTT_BROKER=127.0.0.1
MQTT_BROKER_HOSTNAME=127.0.0.1
MQTT_PORT=8883
MQTT_TOPIC=care/gateway/data

# PKI Certificates (relative to project root or absolute)
CERTS_DIR=./certs
CA_CERT=./certs/ca-cert.pem
CLIENT_CERT=./certs/python-client-cert.pem
CLIENT_KEY=./certs/python-client-key.pem

# Shared Secrets
HMAC_SECRET=your_shared_32byte_hmac_secret_key!

# Blockchain (EVM / Ganache / Hardhat)
GANACHE_URL=http://127.0.0.1:7545
CONTRACT_ADDRESS=0x55E3065D41c5705f26105C3Bdf8F1C146174Fcd2

# Local Database
DB_NAME=medical_data_lake.db
