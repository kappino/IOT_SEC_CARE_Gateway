#include "secrets.h"

// ==========================================
// CONFIGURATION TEMPLATE - DO NOT COMMIT REAL CREDENTIALS
// Copy this file to secrets.cpp and insert your network and PKI parameters.
// ==========================================

// WiFi Settings
const char* WIFI_SSID = "YOUR_WIFI_SSID";
const char* WIFI_PASS = "YOUR_WIFI_PASSWORD";

// MQTT Broker Settings
const char* MQTT_SERVER = "192.168.1.100";
const int MQTT_PORT = 8883;

// Shared secret for source payload HMAC-SHA256 verification
const char* HMAC_SECRET = "your_shared_32byte_hmac_secret_key!";

// Root CA Certificate (PEM Format)
const char ca_cert_pem[] = R"EOF(
-----BEGIN CERTIFICATE-----
MIID... (Insert your private Root CA certificate here) ...
-----END CERTIFICATE-----
)EOF";

// ESP32 Client Certificate (Signed by Root CA with clientAuth extension)
const char client_cert_pem[] = R"EOF(
-----BEGIN CERTIFICATE-----
MIID... (Insert your client certificate here) ...
-----END CERTIFICATE-----
)EOF";

// ESP32 Client RSA Private Key (Traditional format without passphrase)
const char client_key_pem[] = R"EOF(
-----BEGIN RSA PRIVATE KEY-----
MIIE... (Insert your RSA private key here) ...
-----END RSA PRIVATE KEY-----
)EOF";
